# Copie para .env (local) e cadastre as mesmas chaves em
# Cloudflare Pages > Settings > Environment variables (Production e Preview).
# Variáveis VITE_ vão para o navegador: use somente chaves públicas aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
# Nome que aparece no login e no painel
VITE_APP_NAME=Estoque da Loja
# Seu WhatsApp de vendas (só números, com DDI e DDD). Usado em "Quero assinar" e "Renovar".
VITE_SALES_WHATSAPP=5511999999999
