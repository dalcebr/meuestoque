# Só para o script scripts/migrar-fotos-r2.mjs (rodar uma vez no seu computador).
# Copie para .migracao.env — esse arquivo NÃO vai para o Git.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare > R2 > Manage R2 API Tokens > Create API token (Object Read & Write, só este bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=estoque-fotos
# Endereço base das fotos novas: https://seudominio.com.br/media
# (ou o MEDIA_PUBLIC_URL, se você ligou um domínio público ao bucket)
MEDIA_BASE_URL=https://seudominio.com.br/media
